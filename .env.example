# Copie para .env e preencha. O .env fica fora do git.

# Token do Wokwi CI (https://wokwi.com/dashboard/ci). Usado pelo wokwi-cli e pelo servidor MCP wokwi.
WOKWI_CLI_TOKEN=

# Modelo de linguagem no formato provedor:nome, lido pelo init_chat_model.
MODELO=google_genai:gemini-3.5-flash-lite
# Chave do provedor escolhido em MODELO (Gemini: https://aistudio.google.com/apikey).
# Para outro provedor, use a variável que ele exige (ex.: OPENAI_API_KEY) e instale o pacote langchain-<provedor>.
GOOGLE_API_KEY=

# Opcionais: caminhos dos binários, se não estiverem no PATH.
# WOKWI_CLI=
# ARDUINO_CLI=

# Opcional: pasta onde o servidor bancada salva os projetos (padrão: projetos/).
# PASTA_PROJETOS=
