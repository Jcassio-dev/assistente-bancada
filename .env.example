# Copie para .env e preencha. O .env fica fora do git.

# Token do Wokwi CI (https://wokwi.com/dashboard/ci). Usado pelo wokwi-cli e pelo servidor MCP wokwi.
WOKWI_CLI_TOKEN=

# Modelo de linguagem no formato provedor:nome, lido pelo init_chat_model (ex.: openai:gpt-4.1-mini).
MODELO=
# Chave do provedor escolhido em MODELO, com o nome que o provedor usa (ex.: OPENAI_API_KEY).
OPENAI_API_KEY=

# Opcionais: caminhos dos binários, se não estiverem no PATH.
# WOKWI_CLI=
# ARDUINO_CLI=

# Opcional: pasta onde o servidor bancada salva os projetos (padrão: projetos/).
# PASTA_PROJETOS=
